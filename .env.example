# PostgreSQL connection for the application.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reflection_db

# Optional URL for the destructive integration-test fixture.
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reflection_db_test

# Use a unique random secret for each environment.
JWT_SECRET_KEY=replace-this-with-a-random-secret
JWT_ISSUER=ai-psychologist-backend
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Keep revoked tokens long enough for operational investigation and replay detection.
REVOKED_REFRESH_TOKEN_RETENTION_DAYS=30

ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1


# A valid Argon2id hash used for timing-safe checks when an account is missing.
DUMMY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=2,p=1$vayQDkD/F50V36jU50/Xdg$AUd/5qQ+0BXbL2tRx9Ml3gLR/RQBs3sfxwyBGc5zOew'